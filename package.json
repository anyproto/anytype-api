{
  "name": "anytype-api",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "bun run gen-agent-docs && docusaurus start",
    "dev": "bun run start",
    "build": "bun run gen-agent-docs && docusaurus build && bun run check-agent-docs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "fix-openapi": "node scripts/fix-openapi-files.js",
    "pregen-api-docs": "bun run fix-openapi",
    "gen-api-docs": "docusaurus gen-api-docs",
    "clean-api-docs": "docusaurus clean-api-docs",
    "pregen-api-docs:version": "bun run fix-openapi",
    "gen-api-docs:version": "docusaurus gen-api-docs:version",
    "clean-api-docs:version": "docusaurus clean-api-docs:version",
    "make-reference": "bun run clean-api-docs:version anytype:all && bun run gen-api-docs:version anytype:all && bun run clean-api-docs anytypeV2 && bun run gen-api-docs anytypeV2",
    "gen-community-projects": "node scripts/generate-community-projects.js",
    "sync-agent-skill": "node scripts/agent-docs.js sync",
    "gen-agent-docs": "node scripts/agent-docs.js generate",
    "check-agent-docs": "node scripts/agent-docs.js check",
    "lint": "eslint . --ext .ts,.tsx,.md,.mdx",
    "lint:fix": "eslint . --ext .ts,.tsx,.md,.mdx --fix"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-theme-openapi-docs": "5.2.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@docusaurus/eslint-plugin": "3.10.2",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-mdx": "3.8.1",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
